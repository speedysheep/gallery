{
  "name": "gallery",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "dev": "npm run build && wrangler dev --config sites/$GALLERY_SITE/wrangler.jsonc",
    "deploy": "npm run build && wrangler deploy --config sites/$GALLERY_SITE/wrangler.jsonc",
    "test": "node --test test/*.test.mjs",
    "ingest": "node scripts/ingest-media.mjs",
    "thumbnails": "node scripts/generate-thumbnails.mjs",
    "videos": "node scripts/process-videos.mjs",
    "downloadVideos": "node scripts/download-videos.mjs",
    "gallery": "npm run ingest && npm run thumbnails && npm run downloadVideos && npm run videos",
    "deletePicture": "node scripts/delete-media.mjs picture",
    "deleteVideo": "node scripts/delete-media.mjs video",
    "renumber": "node scripts/retrofit-sequence.mjs",
    "audit": "node scripts/audit-orphans.mjs",
    "backfill": "node scripts/backfill-metadata.mjs",
    "repairPosters": "node scripts/repair-posters.mjs"
  },
  "devDependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "sharp": "^0.35.3",
    "wrangler": "^4.120.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
